# Copy to .env and fill in. Never commit the real .env.
GEMINI_API_KEY=your_google_ai_studio_key   # optional: falls back to Ollama, then regex
PRAHARI_API_KEY=choose_a_long_random_string
PRAHARI_ALLOW_DEMO_KEY=false               # true only for throwaway local demos
PRAHARI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PERSONNEL_LOCATION_UPDATE_TIMEOUT_MINUTES=10
GEMINI_MODEL=gemini-flash-lite-latest   # floating alias; never pin a point version (they get retired)

# Read-only access for anyone with the link. Off by default: the roster
# carries live field positions. An observer reads every module and writes
# nothing, and the session is attributable in the audit log.
PRAHARI_ALLOW_OBSERVER=false

# Plant the demonstration season when the station comes up holding nothing.
# Leave false on a real station — a console that invents records is worse
# than an empty one.
PRAHARI_SEED_DEMO_ON_BOOT=false
