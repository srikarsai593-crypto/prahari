# Copy to .env and fill in. Never commit the real .env.
#
# Every variable the backend reads is listed here, with the default it takes
# when unset. A setting that exists in the code and nowhere in the docs is a
# setting nobody knows to check — which for the security-relevant ones below
# is the whole problem.

# ── Credentials ─────────────────────────────────────────────────────────
PRAHARI_API_KEY=choose_a_long_random_string
# PRAHARI_COMMANDER_KEY is accepted as an alias, because the Render blueprint
# once used that name and a key read under the wrong name protects nothing.
PRAHARI_ALLOW_DEMO_KEY=false               # true only for throwaway local demos
# Signs session cookies. Unset, it derives from the commander key, which means
# rotating the key signs everybody out — usually what rotation should mean.
# PRAHARI_SESSION_SECRET=
# How long a session lasts. Default 43200 (12 hours).
# PRAHARI_SESSION_TTL_SECONDS=43200

# ── Who may read and write ──────────────────────────────────────────────
# Serves the roster — including live field positions — to anyone who knows
# the URL, with no session at all. Prefer PRAHARI_ALLOW_OBSERVER for a demo.
PRAHARI_PUBLIC_READS=false
# Hands out an attributable read-only session instead. Writes are refused.
PRAHARI_ALLOW_OBSERVER=false

# ── CORS ────────────────────────────────────────────────────────────────
PRAHARI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# The Vercel project name, which also admits that project's preview
# deployments. Scoped to your project alone.
# PRAHARI_CORS_PROJECT=
# Escape hatch for a console that is not on Vercel. Overrides the above.
# PRAHARI_CORS_ORIGIN_REGEX=

# ── Storage ─────────────────────────────────────────────────────────────
# Where the database lives. A hosted container's filesystem is ephemeral, so
# point this at a mounted disk or every deploy wipes the station's record.
# Defaults to backend/prahari.db.
# PRAHARI_DB_PATH=/var/data/prahari.db

# ── Demonstration ───────────────────────────────────────────────────────
# Plant the demo season when the station comes up holding nothing. Leave
# false on a real station: a console that invents records is worse than an
# empty one.
PRAHARI_SEED_DEMO_ON_BOOT=false

# ── Transport ───────────────────────────────────────────────────────────
# Drops the Secure flag from the session cookie. ONLY for a local console
# served over plain HTTP that is not behind a TLS-terminating proxy; setting
# it on anything public sends the session in the clear.
# PRAHARI_INSECURE_COOKIES=false

# ── Diagnostics ─────────────────────────────────────────────────────────
# PRAHARI_LOG_LEVEL=INFO
PERSONNEL_LOCATION_UPDATE_TIMEOUT_MINUTES=10

# ── Language model ──────────────────────────────────────────────────────
GEMINI_API_KEY=your_google_ai_studio_key   # optional: falls back to Ollama, then regex
GEMINI_MODEL=gemini-flash-lite-latest   # floating alias; never pin a point version (they get retired)
# GEMINI_TIMEOUT=20
