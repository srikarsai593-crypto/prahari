# Optional. The console holds no credential — the commander key is exchanged
# at sign-in for an httpOnly cookie, so there is nothing secret to put here.
#
# Set this only when the backend is somewhere other than http://localhost:8000.
# next.config.ts proxies /api and /ws to it, which is what keeps the console
# and the API same-origin.
# BACKEND_URL=http://localhost:8000
